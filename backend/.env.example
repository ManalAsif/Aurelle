# Copy to backend/.env and fill in real values. Never commit the real .env.

# Local:  mongodb://127.0.0.1:27017/aurelle
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aurelle?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/aurelle
# Optional — database name, overrides the one in MONGO_URI
MONGO_DB_NAME=
JWT_SECRET=change-me-to-a-long-random-string
# Optional — the support chatbot falls back to canned answers without it
GROQ_API_KEY=
# Optional — comma-separated frontend URLs allowed by CORS (all origins allowed when empty)
CLIENT_URL=http://localhost:5173
PORT=5000
# development | production
NODE_ENV=development
